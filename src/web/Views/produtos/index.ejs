 <!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produtos Sincronizados</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/feather-icons@4.28.0/dist/feather.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>
        .table th { white-space: nowrap; }
        .price-column { text-align: right; }
        .stock-column { text-align: center; }
        .no-results { text-align: center; font-style: italic; color: #6c757d; }
    </style>
</head>

<div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 9999; justify-content: center; align-items: center; flex-direction: column;">
    <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;"></div>
    <p class="text-light mt-2">Processando, por favor aguarde...</p>
</div>

<body>
    <!-- Navbar ... -->
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6" href="/">INTERSIG</a>
        <!-- ... -->
    </header>

    <div class="container-fluid">
        <div class="row">
            <%- include('../components/sidebar', { activePage: 'home' }) %>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <p class="h4">Lista de Produtos</p>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <span class="me-3 align-self-center">
                            Total: <span class="badge bg-info"><%=JSON.stringify(pagination.totalRegistros[0].total)  %></span>
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.location.reload()">
                            <span data-feather="refresh-cw"></span> Atualizar
                        </button>
                    </div>
                </div>

                <!-- FORMULÁRIO DE FILTRO (GET) -->
                <div class="card mb-3 bg-light border-light shadow-sm">
                    <div class="card-body py-2">
                      <form action="/produtos" method="GET" class="row g-2 align-items-center">
                            
                            <!-- 1. Campo de Busca -->
                            <div class="col-md-3">
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><span data-feather="search"></span></span>
                                    <input type="text" name="search" id="searchInput" class="form-control" 
                                        placeholder="Buscar..." 
                                        value="<%= typeof filters !== 'undefined' ? filters.search : '' %>">
                                </div>
                            </div>

                            <!-- 2. Filtro de Status -->
                            <div class="col-md-2">
                                <select name="sync_status" class="form-select">
                                   <option value="synced" <%= (typeof filters !== 'undefined' && filters.sync_status === 'synced') ? 'selected' : '' %>>
                                        Sincronizados
                                    </option>
                                    <option value="not_synced" <%= (typeof filters !== 'undefined' && filters.sync_status === 'not_synced') ? 'selected' : '' %>>
                                        Não Enviados (Pendentes)
                                    </option>
                                  
                                </select>
                            </div>

                            <!-- 3. Filtro Grupo -->
                            <div class="col-md-2">
                                <select name="grupo" id="filterGrupo" class="form-select">
                                    <option value="">Grupo</option>
                                    <% grupos.forEach(g => { %>
                                        <option value="<%= g.CODIGO %>"><%= g.NOME %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <!-- 4. Filtro Subgrupo -->
                            <div class="col-md-2">
                                <select name="subgrupo" id="filterSubgrupo" class="form-select">
                                    <option value="">Subgrupo</option>
                                    <% subgrupos.forEach(sg => { %>
                                        <option value="<%= sg.CODIGO %>" data-grupo-pai="<%= sg.COD_GRUPO %>"><%= sg.DESCRICAO %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <!-- 5. Limite -->
                            <div class="col-md-1">
                                <select name="limit" class="form-select">
                                    <option value="20" <%= pagination.limit === 20 ? 'selected' : '' %>>20</option>
                                    <option value="50" <%= pagination.limit === 50 ? 'selected' : '' %>>50</option>
                                    <option value="100" <%= pagination.limit === 100 ? 'selected' : '' %>>100</option>
                                    <option value="1000" <%= pagination.limit === 1000 ? 'selected' : '' %>>1000</option>
                                 </select>
                            </div>

                            <!-- Botão -->
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- LISTA DE PRODUTOS -->
                <% if (produtos && produtos.length > 0) { %>
                    <form id="sendSelectedProductsForm" action="/post-products" method="POST">
                        
                        <!-- Botões de Ação em Massa -->
                        <div class="action-buttons gap-2 d-flex mb-3">
                            <button type="submit" class="btn btn-primary">
                                <span data-feather="send"></span> Enviar Dados
                            </button>
                            <button type="button" id="btnUpdateStock" class="btn btn-warning">
                                <span data-feather="box"></span> Atualizar Estoque
                            </button>
                            <button type="button" id="btnUpdatePrice" class="btn btn-success">
                                <span data-feather="dollar-sign"></span> Atualizar Preço
                            </button>
                        </div>


                        <!--
                        <div class="card mb-3 border-warning shadow-sm">
                            <div class="card-header bg-warning text-dark py-1">
                                <small class="fw-bold"><span data-feather="globe"></span> AÇÕES GLOBAIS (Afeta todos os produtos do filtro atual)</small>
                            </div>
                            <div class="card-body py-2">
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-dark" onclick="executarAcaoGlobal('sync-all')">
                                        <span data-feather="refresh-cw"></span> Sincronizar Tudo
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-dark" onclick="executarAcaoGlobal('canais-all')">
                                        <span data-feather="share-2"></span> Publicar nos Canais
                                    </button>
                                </div>
                                <div class="form-text mt-1" style="font-size: 0.75rem;">
                                    * Estas ações processam todos os <strong><%= JSON.stringify(pagination.totalRegistros[0].total)  %></strong> produtos encontrados.
                                </div>
                            </div>
                        </div>
                         -->



                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-bordered table-sm" id="productsTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col"><input class="form-check-input" type="checkbox" id="selectAllCheckbox"></th>
                                        <th scope="col">Status</th>
                                        <th scope="col">Código</th>
                                        <th scope="col">Descrição</th>
                                        <th scope="col" class="price-column">enviar site ?</th>
                                        <th scope="col" class="stock-column">ativo</th>
                                        <th scope="col" class="text-center">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% produtos.forEach((item) => { %>
                                        <tr data-grupo="<%= item.CODIGO_GRUPO %>" data-subgrupo="<%= item.CODIGO_SUBGRUPO %>">
                                            <th scope="row">
                                                <input class="form-check-input product-checkbox" type="checkbox" name="selected_products" value="<%= item.CODIGO %>">
                                            </th>
                                            <th scope="row">
                                                <% if(item.id_produto_pai){ %> 
                                                    <span data-feather="check-circle" class="text-success" title="Sincronizado"></span>
                                                <% } else { %>
                                                    <span data-feather="circle" class="text-secondary" title="Pendente"></span>
                                                <% } %>

                                    <% if( produtos.IMG  && produtos.IMG.length > 0 ){ %>
                                                
                                          <div class="preview-card" id="preview-${id}">
                                                <div class="preview-img-box">
                                                     
                                                    <img  src="<%= produtos.IMG[0] %>" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" >
                                                    <span class="img-placeholder"  "><span data-feather="image"></span></span>
                                                </div>
                                                <div class="preview-number">Imagem</div>
                                            </div>
                                            <% } %>
                                            
                                            </th>
                                            <td><%= item.CODIGO %></td>
                                            <td>
                                                <%= item.DESCR_CURTA_MKTPLACE || item.DESCRICAO %>
                                                <br><small class="text-muted"><%= item.CATEGORIA || '' %></small>
                                            </td>
                                            <td class="price-column">
                                                  <% if(item.NO_SITE == 'S'){ %> 
                                                    <span data-feather="check" class="text-success" title="Sincronizado"></span>
                                                <% } else { %>
                                                    <span data-feather="x-circle" class="text-secondary" title="Pendente"></span>
                                                <% } %>

                                            </td>
                                            <td class="stock-column">
                                              <% if(item.ATIVO == 'S'){ %> 
                                                    <span data-feather="check" class="text-success" title="Sincronizado"></span>
                                                <% } else { %>
                                                    <span data-feather="x-circle" class="text-secondary" title="Pendente"></span>
                                                <% } %>
                                            </td>

                                            <td class="text-center">
                                              <!--    <a href="/produto/<%= item.CODIGO %>" class="btn btn-sm btn-outline-primary"> -->
                                                        <span data-feather="edit">

                                                 </span>
                                            <!-- </a> -->
                                            </td>
                                        </tr>
                                    <% }) %>
                                    <tr id="noResultsFound" style="display: none;">
                                        <td colspan="7" class="no-results">Nenhum produto encontrado com os filtros.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </form>

                    <!-- PAGINAÇÃO DINÂMICA (Preserva Search e Limit) -->
                    <% if (pagination.totalPages > 1) { %>
                        <nav aria-label="Navegação" class="mt-4">
                            <ul class="pagination justify-content-center">
                                
                                <% 
                                   const extraParams = `&search=${typeof filters !== 'undefined' ? filters.search : ''}&limit=${pagination.limit}&sync_status=${typeof filters !== 'undefined' ? filters.sync_status : ''}`;
                                %>

                               <li class="page-item">
                                <a class="page-link" href="/produtos?page=<%= pagination.page + 1 %><%= extraParams %>">&raquo;</a>
                            </li>

                                <% 
                                let startPage = Math.max(1, pagination.page - 2);
                                let endPage = Math.min(pagination.totalPages, pagination.page + 2);
                                %>

                                <% if (startPage > 1) { %>
                                    <li class="page-item"><a class="page-link" href="/produtos?page=1<%= extraParams %>">1</a></li>
                                    <% if (startPage > 2) { %> <li class="page-item disabled"><span class="page-link">...</span></li> <% } %>
                                <% } %>

                                <% for(let i = startPage; i <= endPage; i++) { %>
                                    <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                                        <a class="page-link" href="/produtos?page=<%= i %><%= extraParams %>"><%= i %></a>
                                    </li>
                                <% } %>

                                <% if (endPage < pagination.totalPages) { %>
                                    <% if (endPage < pagination.totalPages - 1) { %> <li class="page-item disabled"><span class="page-link">...</span></li> <% } %>
                                    <li class="page-item"><a class="page-link" href="/produtos?page=<%= pagination.totalPages %><%= extraParams %>"><%= pagination.totalPages %></a></li>
                                <% } %>

                                <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="/produtos?page=<%= pagination.page + 1 %><%= extraParams %>">&raquo;</a>
                                </li>
                            </ul>
                            <div class="text-center text-muted small mt-2">
                                Página <%= pagination.page %> de <%= pagination.totalPages %>
                            </div>
                        </nav>
                    <% } %>

                <% } else { %>
                    <div class="alert alert-warning mt-4" role="alert">
                        Nenhum produto encontrado com os filtros selecionados.
                    </div>
                <% } %>
            </main>
        </div>
    </div>


    <!-- Bootstrap Bundle JS (inclui Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
        crossorigin="anonymous"></script>
    <script>
        feather.replace(); // Para ativar os ícones Feather

    $(document).ready(function() {
        // Lógica para selecionar/deselecionar todos os checkboxes
        // Lógica do Checkbox Select All
            $('#selectAllCheckbox').on('change', function() {
                $('.product-checkbox').prop('checked', $(this).is(':checked'));
            });

        // Lógica para desmarcar o "Selecionar Todos" se algum item for desmarcado individualmente
        $('.product-checkbox').on('change', function() {
            if (!$(this).is(':checked')) {
                $('#selectAllCheckbox').prop('checked', false);
            }
            // Opcional: se todos estiverem marcados individualmente, marcar o "Selecionar Todos"
            // var allChecked = $('.product-checkbox:not(:checked)').length === 0;
            // $('#selectAllCheckbox').prop('checked', allChecked);
        });


        const $loadingOverlay = $('#loadingOverlay'); // Cache o seletor

        $('#sendSelectedProductsForm').submit(function(event) {
            event.preventDefault();

            const selectedProductIds = [];
            $('input[name="selected_products"]:checked').each(function() {
                selectedProductIds.push($(this).val());
            });

            if (selectedProductIds.length === 0) {
                alert('Por favor, selecione pelo menos um produto para enviar.');
                return;
            }

            console.log('Produtos selecionados:', selectedProductIds);

            $loadingOverlay.css('display', 'flex');
            const $submitButton = $(this).find('button[type="submit"]');
            $submitButton.prop('disabled', true).find('span[data-feather="send"]').hide();
            $submitButton.prepend('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> ');

             $.ajax({
                url: $(this).attr('action'),
                type: $(this).attr('method'),
                data: {
                    produtos: selectedProductIds
                },
                dataType: 'json',
                success: function(response) {
                    console.log('Resposta do servidor:',response);

                    alert(response.message  );
                    window.location.reload(); // Opcional: recarregar
                },
                error: function(xhr, status, error) {
                    let errorMessage = 'Erro ao enviar produtos.';
                    if (xhr.responseJSON && xhr.responseJSON.error) {
                        errorMessage += ' Detalhe: ' + xhr.responseJSON.error;
                        if(xhr.responseJSON.details){
                             errorMessage += ' Especificação: ' + xhr.responseJSON.details;
                        }
                    } else {
                        errorMessage += ' Status: ' + status + ', Erro: ' + error;
                    }
                     alert( JSON.stringify(xhr.responseJSON.message)   || JSON.stringify(xhr.responseText.message || xhr.responseJSON || xhr.responseText) );
                    console.error('Erro na requisição:', xhr.responseJSON || xhr.responseText);
                },
                complete: function() {
                    $loadingOverlay.hide();
                    $submitButton.prop('disabled', false).find('.spinner-border').remove();
                    $submitButton.find('span[data-feather="send"]').show();
                     feather.replace();
                }
            }); 
        });

        // --- FILTRAGEM DA TABELA (busca + grupo + subgrupo) ---
        function filtrarTabela() {
            const searchTerm = $('#searchInput').val().toLowerCase().trim();
            const grupoSel = $('#filterGrupo').val();
            const subgrupoSel = $('#filterSubgrupo').val();
            let rowsFound = 0;

            $('#productsTable tbody tr').each(function() {
                if ($(this).attr('id') === 'noResultsFound') return;

                const codigo = $(this).find('td:nth-child(3)').text().toLowerCase();
                const nome = $(this).find('td:nth-child(4)').text().toLowerCase();
                const rowGrupo = $(this).attr('data-grupo');
                const rowSubgrupo = $(this).attr('data-subgrupo');

                const matchSearch = searchTerm === ''
                    || codigo.includes(searchTerm)
                    || nome.includes(searchTerm);
                const matchGrupo = !grupoSel || rowGrupo === grupoSel;
                const matchSubgrupo = !subgrupoSel || rowSubgrupo === subgrupoSel;

                if (matchSearch && matchGrupo && matchSubgrupo) {
                    $(this).show();
                    rowsFound++;
                } else {
                    $(this).hide();
                }
            });

            if (rowsFound === 0 && searchTerm !== '') {
                $('#noResultsFound').show();
            } else {
                $('#noResultsFound').hide();
            }

            if (searchTerm !== '' || grupoSel || subgrupoSel) {
                $('#selectAllCheckbox').prop('checked', false);
            }
        }

        $('#searchInput').on('keyup', filtrarTabela);
        $('#filterGrupo').on('change', filtrarTabela);
        $('#filterSubgrupo').on('change', filtrarTabela);
        // --- FIM DO SCRIPT DE FILTRAGEM ---

    });

    $('#btnUpdateStock').click(async function() {
            // 1. Coleta os IDs selecionados
            const selectedProductIds = [];
            $('input[name="selected_products"]:checked').each(function() {
                selectedProductIds.push($(this).val());
            });

            // 2. Validação
            if (selectedProductIds.length === 0) {
                alert('Por favor, selecione pelo menos um produto para atualizar o estoque.');
                return;
            }

            if (!confirm(`Deseja atualizar o estoque de ${selectedProductIds.length} produtos na Shopify?`)) {
                return;
            }

            // 3. UI de Carregamento
            const $loadingOverlay = $('#loadingOverlay');
            const $thisBtn = $(this);
            const originalContent = $thisBtn.html();
            
            $loadingOverlay.css('display', 'flex');
            $thisBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Processando...');

            // 4. Requisição AJAX
            try {
                const response = await $.ajax({
                    url: '/post-estoque', // Certifique-se que a rota bate com a definida no backend
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ produtos: selectedProductIds })
                });

                console.log('Resultado Estoque:', response);
                
                // Monta mensagem de feedback
                let msg = response.message;
                if (response.details && response.details.falhas.length > 0) {
                    msg += "\n\nAlguns itens falharam (veja o console para detalhes).";
                    console.warn("Itens com falha:", response.details.falhas);
                }
                
                alert(msg);
                console.log(msg)
                
                // Opcional: Recarregar apenas se quiser limpar a seleção
                // window.location.reload(); 

            } catch (error) {
                console.error('Erro Estoque:', error);
                let errorMsg = "Erro ao conectar com o servidor.";
                if(error.responseJSON && error.responseJSON.message) {
                    errorMsg = error.responseJSON.message;
                }
                alert("Erro: " + errorMsg);
            } finally {
                // 5. Restaura UI
                $loadingOverlay.hide();
                $thisBtn.prop('disabled', false).html(originalContent);
                feather.replace(); // Recarrega os ícones
            }
   });

  $('#btnUpdatePrice').click(async function() {
        // 1. Coleta os IDs
        const selectedProductIds = [];
        $('input[name="selected_products"]:checked').each(function() {
            selectedProductIds.push($(this).val());
        });

        // 2. Validação
        if (selectedProductIds.length === 0) {
            alert('Por favor, selecione pelo menos um produto para atualizar o preço.');
            return;
        }

        if (!confirm(`ATENÇÃO: Deseja atualizar o PREÇO de todos os produtos na Shopify?`)) {
            return;
        }

        // 3. UI Loading
        const $loadingOverlay = $('#loadingOverlay');
        const $thisBtn = $(this);
        const originalContent = $thisBtn.html();

        $loadingOverlay.css('display', 'flex');
        $thisBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Processando...');

        // 4. Requisição AJAX
        try {
            const response = await $.ajax({
                url: '/post-preco', // Rota definida
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ produtos: selectedProductIds })
            });

            console.log('Resultado Preço:', response);

            let msg = response.message;
            if (response.details && response.details.falhas.length > 0) {
                msg += "\n\nAlguns itens falharam. Verifique o console (F12) para detalhes.";
                console.warn("Falhas de Preço:", response.details.falhas);
            }

            alert(msg);

        } catch (error) {
            console.error('Erro Preço:', error);
            let errorMsg = "Erro ao conectar com o servidor.";
            if (error.responseJSON && error.responseJSON.message) {
                errorMsg = error.responseJSON.message;
            }
            alert("Erro: " + errorMsg);
        } finally {
            // 5. Restaura UI
            $loadingOverlay.hide();
            $thisBtn.prop('disabled', false).html(originalContent);
            feather.replace();
        }
    });
async function executarAcaoGlobal(tipoAcao) {
    const total = "<%= pagination.totalRegistros %>";
    
    // Confirmação para evitar cliques acidentais
    const confirmacao = confirm(`ATENÇÃO: Você deseja executar a ação [${tipoAcao}] em TODOS os produtos encontrados? Isso pode levar algum tempo.`);
    if (!confirmacao) return;

    const $loadingOverlay = $('#loadingOverlay');
    $loadingOverlay.css('display', 'flex');

    // Captura os filtros atuais da URL para o backend saber quais produtos processar
    const urlParams = new URLSearchParams(window.location.search);
    const payload = {
        acao: tipoAcao,
        filters: {
            search: urlParams.get('search') || '',
            sync_status: urlParams.get('sync_status') || ''
        }
    };

    try {
        const response = await $.ajax({
            url: '/produtos/acao-global', // Você precisará criar esta rota
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload)
        });

        alert("Processamento concluído: " + response.message);
        window.location.reload();
    } catch (error) {
        console.error('Erro na ação global:', error);
        alert("Erro ao processar ação em massa: " + (error.responseJSON?.message || "Erro interno"));
    } finally {
        $loadingOverlay.hide();
    }
}
    </script>
</body>
</html>