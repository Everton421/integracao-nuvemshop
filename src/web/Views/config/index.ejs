<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuracoes dos Modulos</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <!-- Feather Icons -->
    <script src="https://cdn.jsdelivr.net/npm/feather-icons@4.28.0/dist/feather.min.js"></script>
    <!-- jQuery (necessario para os scripts de interacao) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>

    <style>
        .modulo-card[hidden] {
            display: none !important;
        }
        .card-titulo {
            display: flex;
            align-items: center;
            gap: .5rem;
        }
    </style>
</head>

<!-- Overlay de Carregamento -->
<div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 9999; justify-content: center; align-items: center; flex-direction: column;">
    <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;">
        <span class="visually-hidden">Carregando...</span>
    </div>
    <p class="text-light mt-2">Salvando, por favor aguarde...</p>
</div>

<body>
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6" href="/">INTERSIG</a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse"
            data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false"
            aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-nav">
            <div class="nav-item text-nowrap">
                <a class="nav-link px-3" href="#">Sair (opcional)</a>
            </div>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <%- include('../components/sidebar', { activePage: 'config' }) %>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 mt-4">

                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Configuracoes dos Modulos</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.location.reload()">
                            <span data-feather="refresh-cw"></span>
                            Recarregar
                        </button>
                    </div>
                </div>

                <!-- ALERTA DE RESULTADO -->
                <div id="alertaConfig" class="alert d-none" role="alert">
                    <span data-feather="info"></span>
                    <span id="alertaConfigTexto"></span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>

                <p class="text-muted">
                    Configuracoes gravadas em <code>config</code> (uma linha por modulo).
                    As chaves marcadas como <strong>S</strong> estao ligadas.
                </p>

                <!-- CAMPO DE PESQUISA -->
                <div class="mb-3">
                    <input type="text" id="buscaModulo" class="form-control" placeholder="Pesquisar modulo...">
                </div>

                <%#
                    Cada bloco abaixo e um modulo (uma linha da tabela config).
                    Os campos declarados aqui sao os que o controller grava:
                    cron (S/N), eventos (S/N) e expressao_cron.
                %>

                <!-- PRODUTOS -->
                <div class="card modulo-card mb-4 shadow-sm" data-modulo-card data-modulo="produtos" data-busca="produtos">
                    <div class="card-header d-flex justify-content-between align-items-center bg-light">
                        <h5 class="card-title mb-0 card-titulo"><span data-feather="package"></span> Produtos</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="produtos-cron"
                                        data-chave="cron" data-tipo="bool"
                                        <%= configuracoes.produtos && configuracoes.produtos.cron === 'S' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="produtos-cron">Executar tarefas agendadas (cron)</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="produtos-eventos"
                                        data-chave="eventos" data-tipo="bool"
                                        <%= configuracoes.produtos && configuracoes.produtos.eventos === 'S' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="produtos-eventos">Operar com eventos</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="produtos-expressao_cron">Expressao cron</label>
                                <input type="text" class="form-control" id="produtos-expressao_cron"
                                    data-chave="expressao_cron" data-tipo="text"
                                    value="<%= configuracoes.produtos ? (configuracoes.produtos.expressao_cron || '') : '' %>"
                                    placeholder="*/50 * * * *">
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-end bg-light">
                        <button type="button" class="btn btn-sm btn-primary" data-salvar="produtos">
                            <span data-feather="save"></span> Salvar
                        </button>
                    </div>
                </div>

                <!-- PRECOS -->
                <div class="card modulo-card mb-4 shadow-sm" data-modulo-card data-modulo="precos" data-busca="precos precos">
                    <div class="card-header d-flex justify-content-between align-items-center bg-light">
                        <h5 class="card-title mb-0 card-titulo"><span data-feather="dollar-sign"></span> Precos</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="precos-cron"
                                        data-chave="cron" data-tipo="bool"
                                        <%= configuracoes.precos && configuracoes.precos.cron === 'S' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="precos-cron">Executar tarefas agendadas (cron)</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="precos-eventos"
                                        data-chave="eventos" data-tipo="bool"
                                        <%= configuracoes.precos && configuracoes.precos.eventos === 'S' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="precos-eventos">Operar com eventos</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="precos-expressao_cron">Expressao cron</label>
                                <input type="text" class="form-control" id="precos-expressao_cron"
                                    data-chave="expressao_cron" data-tipo="text"
                                    value="<%= configuracoes.precos ? (configuracoes.precos.expressao_cron || '') : '' %>"
                                    placeholder="*/50 * * * *">
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-end bg-light">
                        <button type="button" class="btn btn-sm btn-primary" data-salvar="precos">
                            <span data-feather="save"></span> Salvar
                        </button>
                    </div>
                </div>

                <!-- CATEGORIAS -->
                <div class="card modulo-card mb-4 shadow-sm" data-modulo-card data-modulo="categorias" data-busca="categorias">
                    <div class="card-header d-flex justify-content-between align-items-center bg-light">
                        <h5 class="card-title mb-0 card-titulo"><span data-feather="layers"></span> Categorias</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="categorias-cron"
                                        data-chave="cron" data-tipo="bool"
                                        <%= configuracoes.categorias && configuracoes.categorias.cron === 'S' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="categorias-cron">Executar tarefas agendadas (cron)</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="categorias-eventos"
                                        data-chave="eventos" data-tipo="bool"
                                        <%= configuracoes.categorias && configuracoes.categorias.eventos === 'S' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="categorias-eventos">Operar com eventos</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="categorias-expressao_cron">Expressao cron</label>
                                <input type="text" class="form-control" id="categorias-expressao_cron"
                                    data-chave="expressao_cron" data-tipo="text"
                                    value="<%= configuracoes.categorias ? (configuracoes.categorias.expressao_cron || '') : '' %>"
                                    placeholder="*/50 * * * *">
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-end bg-light">
                        <button type="button" class="btn btn-sm btn-primary" data-salvar="categorias">
                            <span data-feather="save"></span> Salvar
                        </button>
                    </div>
                </div>

                <!-- ESTOQUE -->
                <div class="card modulo-card mb-4 shadow-sm" data-modulo-card data-modulo="estoque" data-busca="estoque">
                    <div class="card-header d-flex justify-content-between align-items-center bg-light">
                        <h5 class="card-title mb-0 card-titulo"><span data-feather="archive"></span> Estoque</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="estoque-cron"
                                        data-chave="cron" data-tipo="bool"
                                        <%= configuracoes.estoque && configuracoes.estoque.cron === 'S' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="estoque-cron">Executar tarefas agendadas (cron)</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="estoque-eventos"
                                        data-chave="eventos" data-tipo="bool"
                                        <%= configuracoes.estoque && configuracoes.estoque.eventos === 'S' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="estoque-eventos">Operar com eventos</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="estoque-expressao_cron">Expressao cron</label>
                                <input type="text" class="form-control" id="estoque-expressao_cron"
                                    data-chave="expressao_cron" data-tipo="text"
                                    value="<%= configuracoes.estoque ? (configuracoes.estoque.expressao_cron || '') : '' %>"
                                    placeholder="*/50 * * * *">
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-end bg-light">
                        <button type="button" class="btn btn-sm btn-primary" data-salvar="estoque">
                            <span data-feather="save"></span> Salvar
                        </button>
                    </div>
                </div>

                <!-- PEDIDOS -->
                <div class="card modulo-card mb-4 shadow-sm" data-modulo-card data-modulo="pedidos" data-busca="pedidos">
                    <div class="card-header d-flex justify-content-between align-items-center bg-light">
                        <h5 class="card-title mb-0 card-titulo"><span data-feather="shopping-cart"></span> Pedidos</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="pedidos-cron"
                                        data-chave="cron" data-tipo="bool"
                                        <%= configuracoes.pedidos && configuracoes.pedidos.cron === 'S' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="pedidos-cron">Executar tarefas agendadas (cron)</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="pedidos-eventos"
                                        data-chave="eventos" data-tipo="bool"
                                        <%= configuracoes.pedidos && configuracoes.pedidos.eventos === 'S' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="pedidos-eventos">Operar com eventos</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="pedidos-expressao_cron">Expressao cron</label>
                                <input type="text" class="form-control" id="pedidos-expressao_cron"
                                    data-chave="expressao_cron" data-tipo="text"
                                    value="<%= configuracoes.pedidos ? (configuracoes.pedidos.expressao_cron || '') : '' %>"
                                    placeholder="*/50 * * * *">
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-end bg-light">
                        <button type="button" class="btn btn-sm btn-primary" data-salvar="pedidos">
                            <span data-feather="save"></span> Salvar
                        </button>
                    </div>
                </div>

                <!-- INTEGRACAO -->
                <div class="card modulo-card mb-4 shadow-sm" data-modulo-card data-modulo="integracao" data-busca="integracao">
                    <div class="card-header d-flex justify-content-between align-items-center bg-light">
                        <h5 class="card-title mb-0 card-titulo"><span data-feather="settings"></span> Integracao</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="integracao-cron"
                                        data-chave="cron" data-tipo="bool"
                                        <%= configuracoes.integracao && configuracoes.integracao.cron === 'S' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="integracao-cron">Executar tarefas agendadas (cron)</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="integracao-eventos"
                                        data-chave="eventos" data-tipo="bool"
                                        <%= configuracoes.integracao && configuracoes.integracao.eventos === 'S' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="integracao-eventos">Operar com eventos</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="integracao-expressao_cron">Expressao cron</label>
                                <input type="text" class="form-control" id="integracao-expressao_cron"
                                    data-chave="expressao_cron" data-tipo="text"
                                    value="<%= configuracoes.integracao ? (configuracoes.integracao.expressao_cron || '') : '' %>"
                                    placeholder="*/50 * * * *">
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-end bg-light">
                        <button type="button" class="btn btn-sm btn-primary" data-salvar="integracao">
                            <span data-feather="save"></span> Salvar
                        </button>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <!-- Bootstrap Bundle JS (inclui Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
        crossorigin="anonymous"></script>

    <script>
        feather.replace();

        const $overlay = $('#loadingOverlay');

        function mostrarAlerta(mensagem, tipo) {
            const classes = {
                success: 'alert-success',
                danger: 'alert-danger'
            };

            $('#alertaConfig')
                .removeClass('alert-success alert-danger d-none')
                .addClass(classes[tipo]);
            $('#alertaConfigTexto').text(mensagem);
            $('#alertaConfig').removeClass('d-none');
        }

        /**
         * Le os campos de um card e monta o corpo do POST /api/config/:modulo.
         * Booleanos sao enviados como true/false e o controller converte para S/N.
         */
        function montarCampos($card) {
            const campos = {};

            $card.find('[data-chave]').each(function () {
                const $campo = $(this);
                campos[$campo.data('chave')] = $campo.data('tipo') === 'bool'
                    ? $campo.is(':checked')
                    : $campo.val();
            });

            return campos;
        }

        $(document).ready(function () {

            $('[data-salvar]').on('click', function () {
                const modulo = $(this).data('salvar');
                const $card = $('[data-modulo-card][data-modulo="' + modulo + '"]');
                const $botao = $(this).prop('disabled', true);
                $overlay.css('display', 'flex');

                $.ajax({
                    url: '/api/config/' + modulo,
                    method: 'POST',
                    contentType: 'application/json',
                    dataType: 'json',
                    data: JSON.stringify(montarCampos($card)),
                    success: function (resposta) {
                        mostrarAlerta(resposta.msg || 'Configuracoes salvas.', 'success');
                    },
                    error: function (xhr) {
                        const corpo = xhr.responseJSON || {};
                        mostrarAlerta(corpo.error || 'Erro ao salvar configuracoes.', 'danger');
                    },
                    complete: function () {
                        $overlay.hide();
                        $botao.prop('disabled', false);
                        feather.replace();
                    }
                });
            });

            // Filtra os cards pelo nome do modulo
            $('#buscaModulo').on('keyup', function () {
                const termo = $(this).val().toLowerCase().trim();

                $('.modulo-card').each(function () {
                    const texto = String($(this).data('busca')).toLowerCase();
                    $(this).prop('hidden', termo !== '' && texto.indexOf(termo) === -1);
                });
            });
        });
    </script>
</body>
</html>
