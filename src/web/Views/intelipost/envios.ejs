<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Envios Intelipost</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/feather-icons@4.28.0/dist/feather.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>
        .table th { white-space: nowrap; }
        .no-results { text-align: center; font-style: italic; color: #6c757d; }
        .customer-col { max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .chave-nf-col { max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-family: monospace; font-size: 0.8rem; }
        .progress-modal .modal-body { min-height: 200px; }
        .result-item { padding: 6px 0; border-bottom: 1px solid #f0f0f0; }
        .result-item:last-child { border-bottom: none; }
    </style>
</head>

<body>
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6" href="/">INTERSIG</a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse"
            data-bs-target="#sidebarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-nav">
            <div class="nav-item text-nowrap">
                <a class="nav-link px-3" href="#">Sair</a>
            </div>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <%- include('../components/sidebar', { activePage: 'intelipost' }) %>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <p class="h4">Envio para Intelipost</p>
                    <div class="btn-toolbar mb-2 mb-md-0 gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.location.reload()">
                            <span data-feather="refresh-cw"></span>
                            Atualizar Lista
                        </button>
                    </div>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <div class="card mb-4 border-light shadow-sm bg-light">
                    <div class="card-body py-3">
                        <form action="/intelipost/envios" method="GET" class="row g-2 align-items-center">
                            <div class="col-md-4">
                                <input type="text" name="search" class="form-control form-control-sm"
                                       placeholder="Buscar por pedido, cliente ou ID ERP..."
                                       value="<%= typeof filters !== 'undefined' && filters.search ? filters.search : '' %>">
                            </div>
                            <div class="col-md-2">
                                <select name="situacao_nf" class="form-select form-select-sm">
                                    <option value="">Situação NF (Todas)</option>
                                    <option value="A" <%= filters.situacao_nf === 'A' ? 'selected' : '' %>>Autorizada</option>
                                    <option value="R" <%= filters.situacao_nf === 'R' ? 'selected' : '' %>>Rejeitada</option>
                                    <option value="C" <%= filters.situacao_nf === 'C' ? 'selected' : '' %>>Cancelada</option>
                                    <option value="D" <%= filters.situacao_nf === 'D' ? 'selected' : '' %>>Denegada</option>
                                    <option value="N" <%= filters.situacao_nf === 'N' ? 'selected' : '' %>>Não Transmitida</option>
                                    <option value="T" <%= filters.situacao_nf === 'T' ? 'selected' : '' %>>Transmitida</option>
                                    <option value="P" <%= filters.situacao_nf === 'P' ? 'selected' : '' %>>Pendente Transmissão</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select name="status_intelipost" class="form-select form-select-sm">
                                    <option value="">Status Envio (Todos)</option>
                                    <option value="pendente" <%= filters.status_intelipost === 'pendente' ? 'selected' : '' %>>Pendente</option>
                                    <option value="enviado" <%= filters.status_intelipost === 'enviado' ? 'selected' : '' %>>Enviado</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <input type="date" name="data_inicio" class="form-control form-control-sm"
                                       value="<%= typeof filters !== 'undefined' && filters.data_inicio ? filters.data_inicio : new Date().toISOString().split('T')[0] %>">
                            </div>
                            <div class="col-md-2">
                                <input type="date" name="data_fim" class="form-control form-control-sm"
                                       value="<%= typeof filters !== 'undefined' && filters.data_fim ? filters.data_fim : new Date().toISOString().split('T')[0] %>">
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-sm btn-primary w-100">
                                    <span data-feather="filter"></span> Filtrar
                                </button>
                            </div>
                            <div class="col-md-2">
                                <a href="/intelipost/envios" class="btn btn-sm btn-outline-secondary w-100">Limpar</a>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small" id="selectedCount">Nenhum selecionado</span>
                    <button type="button" class="btn btn-success btn-sm" id="btnEnviarLote" disabled>
                        <span data-feather="send"></span>
                        Enviar Selecionados para Intelipost
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover table-bordered table-sm align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col" style="width: 40px;">
                                    <input type="checkbox" class="form-check-input" id="selectAll">
                                </th>
                                <th scope="col">Pedido Shopify / ERP</th>
                                <th scope="col">Cliente</th>
                                <th scope="col">NF (Número / Chave) enviada</th>
                                <th scope="col" class="text-center">Situação NF</th>
                                <th scope="col" class="text-end">Total</th>
                                <th scope="col" class="text-center">Data</th>
                                <th scope="col">Status Envio</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (pedidos && pedidos.length > 0) { %>
                                <% pedidos.forEach(p => { %>
                                    <tr class="<%= p.status_intelipost_label === 'Enviado' ? 'table-success' : '' %>">
                                        <td class="text-center">
                                            <% if (p.pode_enviar) { %>
                                                <input type="checkbox" class="form-check-input pedido-checkbox"
                                                       data-erp-id="<%= p.erp_order_id %>"
                                                       data-pedido-num="<%= p.shopify_order_number %>">
                                            <% } %>
                                        </td>
                                        <td class="fw-bold"><%= p.shopify_order_number %> / <span class="text-muted" style="font-size:0.85rem"><%= p.erp_order_id %></span></td>
                                        <td class="customer-col" title="<%= p.nome_cliente %> (<%= p.email_cliente %>)">
                                            <%= p.nome_cliente %>
                                        </td>
                                        <td class="chave-nf-col" title="<%= p.chave_nf || '' %>">
                                            <%= p.numero_nf ? p.numero_nf : '-' %> /
                                            <%= p.chave_nf ? p.chave_nf.substring(0, 20) + '...' : '-' %>
                                        </td>
                                        <td class="text-center">
                                            <% if (p.SITUACAO_NFE === 'A') { %>
                                                <span class="badge bg-success">Autorizada</span>
                                            <% } else if (p.SITUACAO_NFE === 'R') { %>
                                                <span class="badge bg-danger">Rejeitada</span>
                                            <% } else if (p.SITUACAO_NFE === 'C' || p.CANCELADA_ERP === 'S') { %>
                                                <span class="badge bg-secondary">Cancelada</span>
                                            <% } else if (p.SITUACAO_NFE === 'D') { %>
                                                <span class="badge bg-warning text-dark">Denegada</span>
                                            <% } else if (p.SITUACAO_NFE === 'N') { %>
                                                <span class="badge bg-info text-dark">Não Transmitida</span>
                                            <% } else if (p.SITUACAO_NFE === 'T') { %>
                                                <span class="badge bg-primary">Transmitida</span>
                                            <% } else if (p.SITUACAO_NFE === 'P') { %>
                                                <span class="badge bg-warning text-dark">Pendente</span>
                                            <% } else { %>
                                                <span class="badge bg-light text-muted">-</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end">
                                            R$ <%= parseFloat(p.preco_total).toFixed(2).replace('.', ',') %>
                                        </td>
                                        <td class="text-center"><%= new Date(p.data_criacao).toLocaleDateString('pt-BR') %></td>
                                        <td>
                                            <% if (p.status_intelipost_label === 'Enviado') { %>
                                                <span class="badge bg-success">Enviado</span>
                                            <% } else if (p.status_intelipost_label === 'Pendente') { %>
                                                <span class="badge bg-warning text-dark">Pendente</span>
                                            <% } else if (p.status_intelipost_label === 'NF Cancelada') { %>
                                                <span class="badge bg-secondary">NF Cancelada</span>
                                            <% } else if (p.status_intelipost_label === 'NF Não Autorizada') { %>
                                                <span class="badge bg-info text-dark">NF Não Autorizada</span>
                                            <% } else if (p.status_intelipost_label === 'Sem NF') { %>
                                                <span class="badge bg-light text-muted">Sem NF</span>
                                            <% } else { %>
                                                <span class="badge bg-light text-muted"><%= p.status_intelipost_label %></span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="no-results py-4">Nenhum pedido encontrado.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
                    <nav aria-label="Navegação" class="mt-4 pb-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item <%= pagination.currentPage <= 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="/intelipost/envios?page=<%= pagination.currentPage - 1 %>&search=<%= filters.search %>&situacao_nf=<%= filters.situacao_nf %>&status_intelipost=<%= filters.status_intelipost %>&data_inicio=<%= filters.data_inicio %>&data_fim=<%= filters.data_fim %>">&laquo;</a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">Pág <%= pagination.currentPage %> de <%= pagination.totalPages %></span>
                            </li>
                            <li class="page-item <%= pagination.currentPage >= pagination.totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="/intelipost/envios?page=<%= pagination.currentPage + 1 %>&search=<%= filters.search %>&situacao_nf=<%= filters.situacao_nf %>&status_intelipost=<%= filters.status_intelipost %>&data_inicio=<%= filters.data_inicio %>&data_fim=<%= filters.data_fim %>">&raquo;</a>
                            </li>
                        </ul>
                        <div class="text-center text-muted small mt-2">Total: <%= pagination.totalItems %> pedidos</div>
                    </nav>
                <% } %>
            </main>
        </div>
    </div>

    <div class="modal fade" id="progressModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <span data-feather="send" class="me-2"></span>
                        Enviando para Intelipost
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span id="progressLabel">Aguardando...</span>
                            <span id="progressPercent">0%</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%"></div>
                        </div>
                    </div>
                    <div id="resultsContainer" class="mt-3"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        feather.replace();

        $(document).ready(function() {
            const $selectAll = $('#selectAll');
            const $checkboxes = $('.pedido-checkbox');
            const $btnEnviar = $('#btnEnviarLote');
            const $selectedCount = $('#selectedCount');

            function atualizarSelecao() {
                const selecionados = $('.pedido-checkbox:checked').length;
                const totalHabilitados = $('.pedido-checkbox').length;

                if (selecionados === 0) {
                    $selectedCount.text('Nenhum selecionado');
                    $btnEnviar.prop('disabled', true);
                } else {
                    $selectedCount.text(selecionados + ' de ' + totalHabilitados + ' selecionados');
                    $btnEnviar.prop('disabled', false);
                }

                $selectAll.prop('checked', totalHabilitados > 0 && selecionados === totalHabilitados);
            }

            $selectAll.on('change', function() {
                $checkboxes.prop('checked', this.checked);
                atualizarSelecao();
            });

            $checkboxes.on('change', function() {
                atualizarSelecao();
            });

            $btnEnviar.on('click', async function() {
                const selecionados = $('.pedido-checkbox:checked').map(function() {
                    return parseInt($(this).data('erp-id'));
                }).get();

                if (selecionados.length === 0) {
                    alert('Selecione ao menos um pedido.');
                    return;
                }

                const total = selecionados.length;
                const $progressModal = new bootstrap.Modal(document.getElementById('progressModal'));
                const $progressBar = $('#progressBar');
                const $progressLabel = $('#progressLabel');
                const $progressPercent = $('#progressPercent');
                const $resultsContainer = $('#resultsContainer');

                $resultsContainer.empty();
                $progressBar.css('width', '0%');
                $progressPercent.text('0%');
                $progressLabel.text('Iniciando envio...');
                $progressModal.show();

                let concluidos = 0;
                let sucessos = 0;
                let falhas = 0;

                for (const erpId of selecionados) {
                    try {
                        const response = await $.ajax({
                            url: '/api/intelipost/enviar-lote',
                            method: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ pedidos: [erpId] })
                        });

                        concluidos++;
                        const result = response.results[0];

                        if (result.success) {
                            sucessos++;
                            $resultsContainer.append(
                                '<div class="result-item text-success">' +
                                    '<span data-feather="check-circle" class="me-1"></span> ' +
                                    'Pedido #' + result.erp_order_id + ': <strong>Sucesso</strong> (ID: ' + result.id_pedido_entrega + ')' +
                                '</div>'
                            );
                        } else {
                            falhas++;
                            $resultsContainer.append(
                                '<div class="result-item text-danger">' +
                                    '<span data-feather="x-circle" class="me-1"></span> ' +
                                    'Pedido #' + result.erp_order_id + ': <strong>Falha</strong> - ' + (result.message || 'Erro desconhecido') +
                                '</div>'
                            );
                        }
                    } catch (err) {
                        concluidos++;
                        falhas++;
                        $resultsContainer.append(
                            '<div class="result-item text-danger">' +
                                '<span data-feather="x-circle" class="me-1"></span> ' +
                                'Pedido #' + erpId + ': <strong>Erro de conexão</strong>' +
                            '</div>'
                        );
                    }

                    const percent = Math.round((concluidos / total) * 100);
                    $progressBar.css('width', percent + '%');
                    $progressPercent.text(percent + '%');
                    $progressLabel.text('Processando ' + concluidos + ' de ' + total + '...');
                    feather.replace();
                }

                $progressBar.removeClass('progress-bar-animated');
                $progressLabel.text('Concluído! ' + sucessos + ' sucesso(s), ' + falhas + ' falha(s)');

                if (falhas === 0) {
                    $progressBar.addClass('bg-success');
                } else if (sucessos === 0) {
                    $progressBar.addClass('bg-danger');
                } else {
                    $progressBar.addClass('bg-warning');
                }

                $btnEnviar.prop('disabled', true);
                setTimeout(function() {
                    window.location.reload();
                }, 3000);
            });
        });
    </script>
</body>
</html>
