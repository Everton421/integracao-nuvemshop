<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Vincular Locais Shopify</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/feather-icons@4.28.0/dist/feather.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        body {
            font-size: .875rem;
        }

        /* Ajuste para a Navbar Fixa */
        .navbar-brand {
            padding-top: .75rem;
            padding-bottom: .75rem;
            background-color: rgba(0, 0, 0, .25);
            box-shadow: inset -1px 0 0 rgba(0, 0, 0, .25);
        }

        .navbar .form-control {
            padding: .75rem 1rem;
        }

        /* Ajuste do conteúdo para não sumir atrás da navbar e sidebar */
        [main] {
            padding-top: 20px;
        }

        @media (min-width: 768px) {
            .sidebar {
                top: 0;
                height: 100vh;
                padding-top: 3.5rem; /* Altura da navbar */
            }
            main {
                margin-top: 10px;
            }
        }
    </style>
</head>
<body>

    <!-- NAVBAR TOPO -->
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6" href="/">INTERSIG</a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-nav w-100">
            <!-- Espaço opcional para busca ou links direitos -->
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            
            <!-- SIDEBAR (Incluindo seu componente) -->
            <%- include('../components/sidebar', { activePage: 'setores' }) %>

            <!-- CONTEÚDO PRINCIPAL -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                
                <!-- Título e Botões -->
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h3"><span data-feather="map-pin"></span> Canais de vendas</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <button id="btnSyncShopify" class="btn btn-sm btn-outline-secondary me-2">
                            <span data-feather="refresh-cw"></span> Buscar na Shopify
                        </button>
                    </div>
                </div>

                <!-- Tabela -->
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover table-striped mb-0 align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th width="40%">Canal Shopify (Origem)</th>
                                    <th width="20%">ID Shopify</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(canais && canais.length > 0) { %>
                                    <% canais.forEach(canal => { %>
                                        <tr data-local-id="<%= canal.id %>">
                                            <td>
                                                <strong><%= canal.name %></strong>
                                                <% if(canal.name) { %>
                                                    <br><small class="text-muted"><%= canal.name %></small>
                                                <% } %>
                                            </td>
                                            <td><small class="text-muted"><%= canal.id_shopify ? canal.id_shopify  : 'N/A' %></small></td>
                                           
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="3" class="text-center py-4">Nenhum canal encontrado.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
 
        // Botão Sincronizar
        $('#btnSyncShopify').click(function() {
            if(!confirm("Sincronizar Canais de vendas?")) return;
            const $btn = $(this);
            $btn.prop('disabled', true).text("Aguarde...");
            $.post('/canais/sync', function(res) {
                alert(res.message);
                window.location.reload();
            });
        });
    </script>
    <!-- Bootstrap JS (Necessário para o botão de colapso no mobile) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
</body>
</html>