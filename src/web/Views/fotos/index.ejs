<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consultar Fotos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/feather-icons@4.28.0/dist/feather.min.js"></script>
    <style>
        .sidebar { position: fixed; top: 0; bottom: 0; left: 0; z-index: 100; padding: 48px 0 0; box-shadow: inset -1px 0 0 rgba(0,0,0,.1); }
        .sidebar-sticky { position: relative; top: 0; height: calc(100vh - 48px); padding-top: .5rem; overflow-x: hidden; overflow-y: auto; }
        .nav-link { font-weight: 500; color: #333; display: flex; align-items: center; }
        .nav-link .feather { width: 16px; height: 16px; margin-right: 8px; color: #727272; }
        .nav-link.active { color: #007bff; }
        .nav-link:hover .feather, .nav-link.active .feather { color: inherit; }
        .foto-card { transition: transform .2s; }
        .foto-card:hover { transform: scale(1.03); }
        .foto-img { width: 100%; height: 200px; object-fit: cover; border-radius: 6px; }
        .badge-source { position: absolute; top: 8px; right: 8px; }
    </style>
</head>
<body>
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6" href="/">INTERSIG</a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse"
            data-bs-target="#sidebarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </header>

    <div class="container-fluid">
        <div class="row">
            <%- include('../components/sidebar', { activePage: 'fotos' }) %>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 mt-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Consultar Fotos</h1>
                </div>

                <form method="GET" action="/fotos" class="row g-3 mb-4">
                    <div class="col-auto flex-grow-1">
                        <input type="text" class="form-control" name="sku" placeholder="Digite o SKU do produto"
                               value="<%= sku %>" autofocus>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">
                            <span data-feather="search"></span> Consultar
                        </button>
                    </div>
                </form>

                <% if (sku) { %>
                    <hr>
                    <%
                        const totalFotos = fotosPostgres.length ;
                    %>

                    <% if (totalFotos === 0) { %>
                        <div class="alert alert-info">
                            <span data-feather="info"></span>
                            Nenhuma foto encontrada para o SKU <strong><%= sku %></strong>.
                        </div>
                    <% } else { %>
                        <p class="text-muted">
                            <%= totalFotos %> foto(s) encontrada(s) para o SKU <strong><%= sku %></strong>.
                        </p>

                        <% if (fotosPostgres.length > 0) { %>
                            <h5 class="mb-3">
                                <span data-feather="database"></span>
                                Fotos do PostgreSQL (<%= fotosPostgres.length %>)
                            </h5>
                            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 mb-4">
                                <% fotosPostgres.forEach(function(foto) { %>
                                    <div class="col">
                                        <div class="card foto-card shadow-sm position-relative">
                                            <span class="badge bg-primary badge-source">PostgreSQL</span>
                                            <img src="data:image/jpeg;base64,<%= foto.base64 %>"
                                                 class="foto-img card-img-top" alt="Foto PG <%= foto.id %>"
                                                 onclick="window.open(this.src, '_blank')" style="cursor:pointer;">
                                            <div class="card-footer text-muted small text-center">
                                                ID: <%= foto.id %>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>

                     
                    <% } %>
                <% } %>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        feather.replace();
    </script>
</body>
</html>
