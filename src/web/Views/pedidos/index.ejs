<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedidos Nuvemshop</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Feather Icons -->
    <script src="https://cdn.jsdelivr.net/npm/feather-icons@4.28.0/dist/feather.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>
        .table th { white-space: nowrap; }
        .no-results { text-align: center; font-style: italic; color: #6c757d; }
        .customer-col { max-width: 260px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    </style>
</head>

<body>
    <!-- Navbar -->
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6" href="/">INTERSIG</a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse"
            data-bs-target="#sidebarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-nav">
            <div class="nav-item text-nowrap">
                <a class="nav-link px-3" href="#">Sair</a>
            </div>
        </div>
    </header>

    <!-- Overlay de Carregamento -->
    <div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 9999; justify-content: center; align-items: center; flex-direction: column;">
        <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Carregando...</span>
        </div>
        <p class="text-light mt-2">Processando, por favor aguarde...</p>
    </div>

    <div class="container-fluid">
        <div class="row">

            <!-- Sidebar -->
            <%- include('../components/sidebar', { activePage: 'pedidos' }) %>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Pedidos</h1>
                    <div class="btn-toolbar mb-2 mb-md-0 gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#syncManualModal">
                            <span data-feather="download-cloud"></span>
                            Sincronizar Manualmente
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.location.reload()">
                            <span data-feather="refresh-cw"></span>
                            Atualizar Lista
                        </button>
                    </div>
                </div>

                <!-- FORMULÁRIO DE FILTRO (GET) -->
                <div class="card mb-3 bg-light border-light shadow-sm">
                    <div class="card-body py-2">
                        <form action="/pedidos" method="GET" class="row g-2 align-items-center">

                            <!-- 1. Busca -->
                            <div class="col-md-3">
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><span data-feather="search"></span></span>
                                    <input type="text" name="search" class="form-control"
                                        placeholder="Código, pedido Nuvemshop ou cliente..."
                                        value="<%= filters.search || '' %>">
                                </div>
                            </div>

                            <!-- 2. Data inicial -->
                            <div class="col-md-2">
                                <input type="date" name="data_inicio" class="form-control" title="Data inicial"
                                    value="<%= filters.dataInicio || '' %>">
                            </div>

                            <!-- 3. Data final -->
                            <div class="col-md-2">
                                <input type="date" name="data_fim" class="form-control" title="Data final"
                                    value="<%= filters.dataFim || '' %>">
                            </div>

                            <!-- 4. Itens por página -->
                            <div class="col-md-1">
                                <select name="limit" class="form-select" title="Itens por página">
                                    <% [25, 50, 100, 200].forEach(l => { %>
                                        <option value="<%= l %>" <%= filters.limit === l ? 'selected' : '' %>><%= l %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <!-- Botões -->
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                            </div>
                            <div class="col-md-2">
                                <a href="/pedidos" class="btn btn-outline-secondary w-100">Limpar</a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- LISTA DE PEDIDOS -->
                <% if (pedidos && pedidos.length > 0) { %>
                    <p>Total de pedidos encontrados: <span class="badge bg-info"><%= pagination.totalItems %></span></p>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-bordered table-sm align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th scope="col">Código ERP</th>
                                    <th scope="col">Pedido Nuvemshop</th>
                                    <th scope="col">Cliente</th>
                                    <th scope="col" class="text-end">Total</th>
                                    <th scope="col">Data</th>
                                    <th scope="col" class="text-center">Situação</th>
                                    <th scope="col">Contato</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% pedidos.forEach(p => { %>
                                    <tr>
                                        <td class="fw-bold"><%= p.CODIGO %></td>
                                        <td><%= p.COD_SITE %></td>
                                        <td class="customer-col" title="<%= p.NOME_CLIENTE %>"><%= p.NOME_CLIENTE || 'N/A' %></td>
                                        <td class="text-end">R$ <%= Number(p.TOTAL_GERAL).toFixed(2).replace('.', ',') %></td>
                                        <td><%= p.DATA_PEDIDO ? new Date(p.DATA_PEDIDO).toLocaleDateString('pt-BR') : '-' %></td>
                                        <td class="text-center">
                                            <% if (p.SITUACAO === 'AI') { %>
                                                <span class="badge bg-success" title="<%= p.SITUACAO %>">Aprovado</span>
                                            <% } else if (p.SITUACAO === 'EA') { %>
                                                <span class="badge bg-warning text-dark" title="<%= p.SITUACAO %>">Pendente</span>
                                            <% } else if (p.SITUACAO === 'RE') { %>
                                                <span class="badge bg-danger" title="<%= p.SITUACAO %>">Cancelado</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary">-</span>
                                            <% } %>
                                        </td>
                                        <td><small class="text-muted"><%= p.CONTATO %></small></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- PAGINAÇÃO -->
                    <% if (pagination.totalPages > 1) { %>
                        <%
                            const queryBase = {
                                search: filters.search || '',
                                data_inicio: filters.dataInicio || '',
                                data_fim: filters.dataFim || '',
                                limit: pagination.perPage
                            };
                            const buildUrl = (page) => {
                                const params = new URLSearchParams({ ...queryBase, page });
                                return '/pedidos?' + params.toString();
                            };
                        %>
                        <nav aria-label="Navegação de página" class="mt-3 pb-4">
                            <ul class="pagination justify-content-center">
                                <li class="page-item <%= pagination.currentPage <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="<%= buildUrl(pagination.currentPage - 1) %>">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>

                                <li class="page-item disabled">
                                    <span class="page-link">Página <%= pagination.currentPage %> de <%= pagination.totalPages %></span>
                                </li>

                                <li class="page-item <%= pagination.currentPage >= pagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="<%= buildUrl(pagination.currentPage + 1) %>">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                            <div class="text-center text-muted small mt-2">
                                Total de registros: <%= pagination.totalItems %>
                            </div>
                        </nav>
                    <% } %>

                <% } else { %>
                    <div class="alert alert-warning" role="alert">
                        Nenhum pedido encontrado com os filtros selecionados.
                    </div>
                <% } %>
            </main>
        </div>
    </div>

    <!-- MODAL DE SINCRONIZAÇÃO MANUAL -->
    <div class="modal fade" id="syncManualModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <span data-feather="download-cloud" class="me-2"></span>
                        Importar Pedidos da Nuvemshop
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info small">
                        <span data-feather="info"></span>
                        O sistema buscará os pedidos criados no período informado e os importará para o ERP.
                    </div>

                    <form id="formSyncManual">
                        <div class="mb-3">
                            <label for="syncDataInicio" class="form-label fw-bold">Data/hora inicial:</label>
                            <input type="datetime-local" class="form-control" id="syncDataInicio" name="data_inicio" required>
                        </div>
                        <div class="mb-3">
                            <label for="syncDataFim" class="form-label fw-bold">Data/hora final (opcional):</label>
                            <input type="datetime-local" class="form-control" id="syncDataFim" name="data_fim">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="btnConfirmSync">
                        Confirmar Importação
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS (inclui Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        feather.replace();

        $(document).ready(function() {

            // Pré-preencher a data inicial com ontem (sugestão)
            const now = new Date();
            now.setDate(now.getDate() - 1);
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            $('#syncDataInicio').val(now.toISOString().slice(0, 16));

            const $loadingOverlay = $('#loadingOverlay');

            $('#btnConfirmSync').click(async function() {
                const dataInicio = $('#syncDataInicio').val();
                const dataFim = $('#syncDataFim').val();

                if (!dataInicio) {
                    alert('Por favor, selecione a data/hora inicial.');
                    return;
                }

                if (dataFim && dataFim < dataInicio) {
                    alert('A data final não pode ser anterior à data inicial.');
                    return;
                }

                if (!confirm('Isso irá buscar pedidos na Nuvemshop e pode levar alguns segundos. Deseja continuar?')) {
                    return;
                }

                const $btn = $(this);
                const originalText = $btn.html();
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Buscando...');
                $loadingOverlay.css('display', 'flex');

                try {
                    const response = await $.ajax({
                        url: '/api/pedidos/sync-manual',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ data_inicio: dataInicio, data_fim: dataFim || null })
                    });

                    alert(response.message || 'Sincronização concluída com sucesso!');
                    window.location.reload();

                } catch (err) {
                    console.error(err);
                    let msg = 'Erro ao conectar com o servidor.';
                    if (err.responseJSON && err.responseJSON.message) {
                        msg = err.responseJSON.message;
                    }
                    alert('Erro: ' + msg);
                } finally {
                    $loadingOverlay.hide();
                    $btn.prop('disabled', false).html(originalText);
                    feather.replace();
                }
            });
        });
    </script>
</body>

</html>
