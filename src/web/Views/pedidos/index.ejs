<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedidos Shopify</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Feather Icons -->
    <script src="https://cdn.jsdelivr.net/npm/feather-icons@4.28.0/dist/feather.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>
        .table th { white-space: nowrap; }
        .no-results { text-align: center; font-style: italic; color: #6c757d; }
        .json-pre {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            max-height: 400px;
            overflow-y: auto;
            font-size: 0.85rem;
            border: 1px solid #dee2e6;
        }
        /* Badges personalizados para status financeiro */
        .badge-paid { background-color: #198754; }
        .badge-pending { background-color: #ffc107; color: #000; }
        .badge-refunded { background-color: #dc3545; }
        
        .customer-col { max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    </style>
</head>

<body>
    <!-- Navbar -->
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6" href="/">INTERSIG</a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse"
            data-bs-target="#sidebarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-nav">
            <div class="nav-item text-nowrap">
                <a class="nav-link px-3" href="#">Sair</a>
            </div>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            
            <!-- Sidebar -->
            <%- include('../components/sidebar', { activePage: 'pedidos' }) %>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                
              <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <p class="h4">Gerenciamento de Pedidos</p>
                <div class="btn-toolbar mb-2 mb-md-0 gap-2"> <!-- gap-2 para espaçamento -->
                    
                    <!-- NOVO BOTÃO DE SINCRONIZAÇÃO MANUAL -->
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#syncManualModal">
                        <span data-feather="download-cloud"></span>
                        Sincronizar Manualmente
                    </button>

                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.location.reload()">
                        <span data-feather="refresh-cw"></span>
                        Atualizar Lista
                    </button>
                </div>
            </div>

                <!-- Filtros -->
                <div class="card mb-4 border-light shadow-sm bg-light">
                    <div class="card-body py-3">
                        <form action="/pedidos" method="GET" class="row g-2 align-items-center">
                            <div class="col-md-5">
                                <input type="text" name="search" class="form-control form-control-sm" 
                                       placeholder="Busca: Pedido #, Cliente, Email ou ID ERP..." 
                                       value="<%=   filters !== 'undefined'  ? filters.search : '' %>">
                            </div>
                            <div class="col-md-3">
                                <select name="sync_status" class="form-select form-select-sm">
                                    <option value="">Status Integração (Todos)</option>
                                    <option value="pending_validation" <%= filters.sync_status === 'pending_validation' ? 'selected' : '' %>>Pendente</option>
                                    <option value="approved" <%= filters.sync_status === 'approved' ? 'selected' : '' %>>Aprovado</option>
                                    <option value="synced" <%= filters.sync_status === 'synced' ? 'selected' : '' %>>Sincronizado</option>
                                    <option value="error" <%= filters.sync_status === 'error' ? 'selected' : '' %>>Erro</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-sm btn-primary w-100">
                                    <span data-feather="filter"></span> Filtrar
                                </button>
                            </div>
                            <div class="col-md-2">
                                <a href="/pedidos" class="btn btn-sm btn-outline-secondary w-100">Limpar</a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Tabela -->
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-bordered table-sm align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col">Data</th>
                                <th scope="col">Pedido (Shopify)</th>
                                <th scope="col">Cliente</th>
                                <th scope="col" class="text-end">Total</th>
                                <th scope="col" class="text-center">Pagamento</th>
                                <th scope="col" class="text-center">Integração</th>
                                <th scope="col">ID ERP</th>
                                <th scope="col" class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (pedidos && pedidos.length > 0) { %>
                                <% pedidos.forEach(p => { %>
                                    <tr>
                                        <!-- Data -->
                                        <td><%= new Date(p.data_criacao).toLocaleDateString('pt-BR') %></td>
                                        
                                        <!-- Número do Pedido -->
                                        <td class="fw-bold"><%= p.shopify_order_number %></td>
                                        
                                        <!-- Cliente (Nome + Email) -->
                                        <td class="customer-col" title="<%= p.nome_cliente %> (<%= p.email_cliente %>)">
                                            <%= p.nome_cliente %>
                                        </td>
                                        
                                        <!-- Preço Total -->
                                        <td class="text-end">
                                            R$ <%= parseFloat(p.preco_total).toFixed(2).replace('.', ',') %>
                                        </td>
                                        
                                        <!-- Status Pagamento -->
                                        <td class="text-center">
                                            <% 
                                                let badgeClass = 'bg-secondary';
                                                if(p.status_pagamento === 'PAID') badgeClass = 'bg-success';
                                                else if(p.status_pagamento === 'PENDING') badgeClass = 'bg-warning text-dark';
                                                else if(p.status_pagamento === 'REFUNDED') badgeClass = 'bg-danger';
                                            %>
                                            <span class="badge <%= badgeClass %>"><%= p.status_pagamento %></span>
                                        </td>
                                        
                                        <!-- Status Integração -->
                                        <td class="text-center">
                                            <% if (p.sync_status === 'synced') { %>
                                                <span class="badge bg-success">Sincronizado</span>
                                            <% } else if (p.sync_status === 'error') { %>
                                                <span class="badge bg-danger" title="<%= p.error_message %>">Erro</span>
                                            <% } else if (p.sync_status === 'approved') { %>
                                                <span class="badge bg-info">Aprovado</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary">Pendente</span>
                                            <% } %>
                                        </td>
                                        
                                        <!-- ID ERP -->
                                        <td class="text-center text-muted">
                                            <%= p.erp_order_id ? p.erp_order_id : '-' %>
                                        </td>
                                        
                                        <!-- Botão JSON -->
                                        <td class="text-center">
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-info btn-view-json"
                                                    data-id="<%= p.shopify_order_number %>"
                                                    data-json="<%= p.dados_pedido %>"
                                                    title="Ver JSON da Shopify">
                                                <span data-feather="file-text"></span>
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="no-results py-4">Nenhum pedido encontrado.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Paginação -->
                <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
                    <nav aria-label="Navegação" class="mt-4 pb-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item <%= pagination.currentPage <= 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="/pedidos?page=<%= pagination.currentPage - 1 %>&search=<%= filters.search %>&sync_status=<%= filters.sync_status %>">&laquo;</a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">Pág <%= pagination.currentPage %> de <%= pagination.totalPages %></span>
                            </li>
                            <li class="page-item <%= pagination.currentPage >= pagination.totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="/pedidos?page=<%= pagination.currentPage + 1 %>&search=<%= filters.search %>&sync_status=<%= filters.sync_status %>">&raquo;</a>
                            </li>
                        </ul>
                        <div class="text-center text-muted small mt-2">Total: <%= pagination.totalItems %> pedidos</div>
                    </nav>
                <% } %>

            </main>
        </div>
    </div>

    <!-- Modal JSON -->
    <div class="modal fade" id="jsonModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Detalhes do Pedido #<span id="modalOrderNumber"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <pre id="modalJsonContent" class="json-pre"></pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="syncManualModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <span data-feather="download-cloud" class="me-2"></span>
                    Importar Pedidos da Shopify
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info small">
                    <span data-feather="info"></span>
                    Use esta opção caso a integração automática tenha falhado. O sistema buscará todos os pedidos criados <strong>após</strong> a data selecionada.
                </div>
                
                <form id="formSyncManual">
                    <div class="mb-3">
                        <label for="syncDate" class="form-label fw-bold">Buscar pedidos a partir de:</label>
                        <input type="datetime-local" class="form-control" id="syncDate" name="data_inicio" required>
                        <div class="form-text">Selecione a data e hora aproximada da falha.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmSync">
                    Confirmar Importação
                </button>
            </div>
        </div>
    </div>
</div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
 
 <script>
    $(document).ready(function() {
        
        // 1. Pré-preencher com a data de ontem (sugestão)
        const now = new Date();
        now.setDate(now.getDate() - 1); // Subtrai 1 dia
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset()); // Ajuste fuso horário local
        const yesterdayISO = now.toISOString().slice(0, 16);
        $('#syncDate').val(yesterdayISO);

        // 2. Ação do Botão Confirmar
        $('#btnConfirmSync').click(async function() {
            const dataInicio = $('#syncDate').val();

            if (!dataInicio) {
                alert("Por favor, selecione uma data.");
                return;
            }

            if (!confirm("Isso irá buscar pedidos na Shopify e pode levar alguns segundos. Deseja continuar?")) {
                return;
            }

            // UI Loading
            const $btn = $(this);
            const originalText = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Buscando...');
            
            // Fecha o modal para mostrar o loading na tela principal se preferir, ou mantém aberto
            // $('#syncManualModal').modal('hide'); 

            try {
                const response = await $.ajax({
                    url: '/api/pedidos/sync-manual', // Rota que vamos criar no passo 2
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ data_inicio: dataInicio })
                });

                alert(response.message || "Sincronização concluída com sucesso!");
                window.location.reload(); // Recarrega para ver os novos pedidos

            } catch (err) {
                console.error(err);
                let msg = "Erro ao conectar com o servidor. "  ;
                if (err.responseJSON && err.responseJSON.message) {
                    msg = err.responseJSON.message;
                }
                alert("Erro: " + msg);
            } finally {
                $btn.prop('disabled', false).html(originalText);
            }
        });
    });
</script>
 
 
 <script>
        feather.replace();

        $(document).ready(function() {
            // Modal Logica
            $('.btn-view-json').on('click', function() {
                const id = $(this).data('id');
                let rawJson = $(this).attr('data-json'); 
                const $modalContent = $('#modalJsonContent');
                
                $('#modalOrderNumber').text(id);

                try {
                    if (rawJson) {
                         // Tratamento para remover aspas extras se o EJS tiver escapado
                        if (typeof rawJson === 'string' && rawJson.startsWith('"') && rawJson.endsWith('"')) {
                            rawJson = rawJson.substring(1, rawJson.length - 1);
                        }
                        
                        // Parse se for string, ou usa direto se já for objeto
                        const jsonObj = (typeof rawJson === 'string') ? JSON.parse(rawJson) : rawJson;
                        $modalContent.text(JSON.stringify(jsonObj, null, 4));
                    } else {
                        $modalContent.text("JSON Vazio.");
                    }
                } catch (e) {
                    $modalContent.text(rawJson || "Erro ao formatar.");
                }

                new bootstrap.Modal(document.getElementById('jsonModal')).show();
            });
        });
    </script>
</body>
</html>