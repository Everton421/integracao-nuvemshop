<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categorias Sincronizadas</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <!-- Feather Icons -->
    <script src="https://cdn.jsdelivr.net/npm/feather-icons@4.28.0/dist/feather.min.js"></script>
    <!-- jQuery (NECESSÁRIO PARA OS SCRIPTS DE INTERAÇÃO) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>

    <style>
        .table th {
            white-space: nowrap;
        }
        .action-buttons {
            margin-top: 20px;
            margin-bottom: 20px;
        }
        .no-results {
            text-align: center;
            font-style: italic;
            color: #6c757d;
        }
    </style>
</head>

<!-- Overlay de Carregamento -->
<div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 9999; justify-content: center; align-items: center; flex-direction: column;">
    <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;">
        <span class="visually-hidden">Carregando...</span>
    </div>
    <p class="text-light mt-2">Processando, por favor aguarde...</p>
</div>

<body>
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6" href="/">INTERSIG</a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse"
            data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false"
            aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-nav">
            <div class="nav-item text-nowrap">
                <a class="nav-link px-3" href="#">Sair (opcional)</a>
            </div>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <%#
              Se tiver uma sidebar:
              <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
                  <!-- Conteúdo da Sidebar -->
              </nav>
            %>
   <%- include('../components/sidebar', { activePage: 'categorias' }) %>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 mt-4" > 
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Lista de Categorias</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.location.reload()">
                            <span data-feather="refresh-cw"></span>
                            Atualizar Lista
                        </button>
                    </div>
                </div>

                <% if (categorias && categorias.length > 0) { %>
                    <p>Total de categorias encontradas: <span class="badge bg-info"><%= pagination.totalItems %></span></p>

                    <!-- FORMULÁRIO DE FILTRO (GET) -->
                    <div class="card mb-3 bg-light border-light shadow-sm">
                        <div class="card-body py-2">
                            <form action="/categorias" method="GET" class="row g-2 align-items-center">

                                <!-- 1. Campo de Busca -->
                                <div class="col-md-3">
                                    <div class="input-group">
                                        <span class="input-group-text bg-white"><span data-feather="search"></span></span>
                                        <input type="text" name="search" class="form-control"
                                            placeholder="Buscar por código ou nome..."
                                            value="<%= filters.search || '' %>">
                                    </div>
                                </div>

                                <!-- 2. Filtro de Status de Envio -->
                                <div class="col-md-2">
                                    <select name="sync_status" class="form-select">
                                        <option value="">Todos</option>
                                        <option value="synced" <%= filters.syncStatus === 'synced' ? 'selected' : '' %>>
                                            Enviados
                                        </option>
                                        <option value="not_synced" <%= filters.syncStatus === 'not_synced' ? 'selected' : '' %>>
                                            Não Enviados
                                        </option>
                                    </select>
                                </div>

                                <!-- 3. Filtro de Nível -->
                                <div class="col-md-2">
                                    <select name="nivel" class="form-select">
                                        <option value="">Nível</option>
                                        <option value="grupo" <%= filters.nivel === 'grupo' ? 'selected' : '' %>>Grupos</option>
                                        <option value="subgrupo" <%= filters.nivel === 'subgrupo' ? 'selected' : '' %>>Subgrupos</option>
                                    </select>
                                </div>

                                <!-- 4. Filtro de Disponibilidade -->
                                <div class="col-md-2">
                                    <select name="disponivel" class="form-select" title="Disponibilidade para envio">
                                        <option value="S" <%= filters.disponivel !== 'N' ? 'selected' : '' %>>Disponíveis para envio</option>
                                        <option value="N" <%= filters.disponivel === 'N' ? 'selected' : '' %>>Todas</option>
                                    </select>
                                </div>

                                <!-- 5. Itens por página -->
                                <div class="col-md-1">
                                    <select name="limit" class="form-select" title="Itens por página">
                                        <% [25, 50, 100, 200].forEach(l => { %>
                                            <option value="<%= l %>" <%= filters.limit === l ? 'selected' : '' %>><%= l %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <!-- Botão -->
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- INÍCIO DO FORMULÁRIO DE ENVIO -->
                    <form id="sendSelectedCategoriesForm" action="/api/categorias" method="POST">

                       <div class="action-buttons">
                            <button type="submit" class="btn btn-primary">
                                <span data-feather="send"></span>
                                Enviar Selecionadas
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-bordered table-sm" id="categoriesTable">
                                <thead class="table-dark">
                                            <tr>
                                                <th scope="col">
                                                    <input class="form-check-input" type="checkbox" id="selectAllCheckbox">
                                                </th>
                                                <th scope="col">Enviado</th>
                                                <th scope="col">Nível</th>
                                                <th scope="col">Código</th>
                                                <th scope="col">Nome/Descrição</th>
                                                <th scope="col">Grupo Pai</th>
                                                <th scope="col">Disponível</th>
                                                <th scope="col">ID Nuvemshop</th>
                                                <th scope="col">Último Envio</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <% categorias.forEach((item) => { %>
                                                <tr>
                                                    <th scope="row">
                                                        <!-- O prefixo no value evita confundir grupo 10 de subgrupo 10 -->
                                                        <input class="form-check-input category-checkbox"
                                                            type="checkbox"
                                                            name="selected_categories"
                                                            value="<%= item.nivel %>:<%= item.codigo %>">
                                                    </th>
                                                    <th scope="row">
                                                        <% if(item.id){ %>
                                                            <span data-feather="check-circle" class="text-success" title="Enviado"></span>
                                                        <% } else { %>
                                                            <span data-feather="circle" class="text-secondary" title="Não enviado"></span>
                                                        <% } %>
                                                    </th>
                                                    <td>
                                                        <% if(item.nivel === 'grupo'){ %>
                                                            <span class="badge bg-primary">Grupo</span>
                                                        <% } else { %>
                                                            <span class="badge bg-secondary">Subgrupo</span>
                                                        <% } %>
                                                    </td>
                                                    <td><%= item.codigo %></td>
                                                    <td><%= item.nome || 'N/A' %></td>
                                                    <td>
                                                        <% if(item.nivel === 'subgrupo'){ %>
                                                            <%= item.codigo_grupo_pai %>
                                                        <% } else { %>
                                                            <span class="text-muted">-</span>
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <% if(item.ativo === 'S' && item.no_site === 'S'){ %>
                                                            <span class="badge bg-success">Sim</span>
                                                        <% } else { %>
                                                            <span class="badge bg-warning text-dark" title="ATIVO=<%= item.ativo %> | NO_SITE=<%= item.no_site %>">Não</span>
                                                        <% } %>
                                                    </td>
                                                    <td><small class="text-muted"><%= item.id_nuvemshop || '-' %></small></td>
                                                    <td>
                                                        <% if(item.id){ %>
                                                     
                                                         <%= new Date(item.ultimo_envio).toLocaleDateString('pt-BR' ) %> 

                                                        <% } else { %>
                                                            <span class="text-muted">-</span>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                            </tbody>
                            </table>
                        </div>
                    </form>
                    <!-- FIM DO FORMULÁRIO -->

                    <!-- PAGINAÇÃO -->
                    <% if (pagination.totalPages > 1) { %>
                        <%
                            const queryBase = {
                                search: filters.search || '',
                                sync_status: filters.syncStatus || '',
                                nivel: filters.nivel || '',
                                disponivel: filters.disponivel || 'S',
                                limit: pagination.perPage
                            };
                            const buildUrl = (page) => {
                                const params = new URLSearchParams({ ...queryBase, page });
                                return '/categorias?' + params.toString();
                            };
                        %>
                        <nav aria-label="Navegação de página" class="mt-3 pb-4">
                            <ul class="pagination justify-content-center">
                                <!-- Botão Anterior -->
                                <li class="page-item <%= pagination.currentPage <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="<%= buildUrl(pagination.currentPage - 1) %>">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>

                                <li class="page-item disabled">
                                    <span class="page-link">Página <%= pagination.currentPage %> de <%= pagination.totalPages %></span>
                                </li>

                                <!-- Botão Próximo -->
                                <li class="page-item <%= pagination.currentPage >= pagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="<%= buildUrl(pagination.currentPage + 1) %>">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                            <div class="text-center text-muted small mt-2">
                                Total de registros: <%= pagination.totalItems %>
                            </div>
                        </nav>
                    <% } %>

                <% } else { %>
                    <div class="alert alert-warning" role="alert">
                        Nenhuma categoria encontrada com os filtros selecionados.
                    </div>
                <% } %>
            </main>
        </div>
    </div>

    <!-- Bootstrap Bundle JS (inclui Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
        crossorigin="anonymous"></script>

    <!-- SCRIPT ADAPTADO PARA CATEGORIAS -->
    <script>
        feather.replace(); // Ativa os ícones Feather

        $(document).ready(function() {
            // Lógica para selecionar/deselecionar todos os checkboxes
            $('#selectAllCheckbox').on('change', function() {
                $('.category-checkbox:visible').prop('checked', $(this).is(':checked'));
            });

            // Lógica para desmarcar o "Selecionar Todos" se algum item for desmarcado
            $('.category-checkbox').on('change', function() {
                if (!$(this).is(':checked')) {
                    $('#selectAllCheckbox').prop('checked', false);
                }
            });

            const $loadingOverlay = $('#loadingOverlay');

            // Lógica de envio do formulário com AJAX
            $('#sendSelectedCategoriesForm').submit(function(event) {
                event.preventDefault(); // Impede o envio padrão do formulário

                const selectedCategoryIds = [];
                $('input[name="selected_categories"]:checked').each(function() {
                    selectedCategoryIds.push($(this).val());
                });

                if (selectedCategoryIds.length === 0) {
                    alert('Por favor, selecione pelo menos uma categoria para enviar.');
                    return;
                }

                $loadingOverlay.css('display', 'flex');
                const $submitButton = $(this).find('button[type="submit"]');
                $submitButton.prop('disabled', true).find('span[data-feather="send"]').hide();
                $submitButton.prepend('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> ');

                $.ajax({
                    url: $(this).attr('action'), // /api/categorias
                    type: $(this).attr('method'), // POST
                    data: {
                        categorias: selectedCategoryIds // Nome do array enviado para o backend
                    },
                    dataType: 'json',
                    success: function(response) {
                        alert(response.msg || 'Categorias enviadas com sucesso!');
                        // Opcional: recarregar a página para ver o status atualizado
                        window.location.reload(); 
                    },
                    error: function(xhr, status, error) {
                        let errorMessage = 'Erro ao enviar categorias.';
                        if (xhr.responseJSON && xhr.responseJSON.error) {
                            errorMessage += ' Detalhe: ' + xhr.responseJSON.error;
                        } else {
                            errorMessage += ' Status: ' + status + ', Erro: ' + error;
                        }
                        alert(errorMessage);
                    },
                    complete: function() {
                        // Esconde o overlay e restaura o botão em qualquer caso (sucesso ou erro)
                        $loadingOverlay.hide();
                        $submitButton.prop('disabled', false).find('.spinner-border').remove();
                        $submitButton.find('span[data-feather="send"]').show();
                        feather.replace();
                    }
                });
            });
        });
    </script>
</body>
</html>